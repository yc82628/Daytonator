# --- Daytona (the detonation backend) ---
DAYTONA_API_KEY=dtn_xxx
DAYTONA_TARGET=eu          # Berlin event = EU region
BACKEND=daytona           # use real Daytona forking (set to local for offline)

# --- LLM for the verdict + explanation (optional) ---
# Featherless: free open-source models, OpenAI-compatible. Tried first.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct   # bump to a bigger model for sharper verdicts
# Anthropic: used only if Featherless isn't set.
ANTHROPIC_API_KEY=
# With neither key set, Detonator uses a transparent built-in heuristic.
